{
  "expo": {
    "name": "Sortshot",
    "slug": "sortshot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sortshot",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sortshot.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Sortshot reads your screenshots on this phone to sort them and find the text in them. Nothing is uploaded.",
        "NSFaceIDUsageDescription": "Sortshot uses Face ID to open your hidden screenshots.",
        "NSCalendarsFullAccessUsageDescription": "Sortshot adds events from your screenshots to your calendar when you ask."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6D28D9",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.sortshot.app",
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-media-library",
      "expo-calendar",
      "expo-local-authentication",
      "expo-font",
      "expo-sharing",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#6D28D9",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": ""
      },
      "admob": {
        "bannerHomeAndroid": "ca-app-pub-3940256099942544/6300978111",
        "bannerHomeIos": "ca-app-pub-3940256099942544/2934735716",
        "rewardedCleanAndroid": "ca-app-pub-3940256099942544/5224354917",
        "rewardedCleanIos": "ca-app-pub-3940256099942544/1712485313"
      }
    }
  }
}
